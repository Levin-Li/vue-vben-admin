{
  "name": "@levin/oak-base-admin",
  "version": "6.0.19",
  "description": "Levin Oak base admin frontend module.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node ../../../scripts/sync-framework-package-metadata.mjs --package . && node ../../../scripts/sync-frontend-rule-docs.mjs && node ../../../scripts/generate-help-center.mjs && pnpm unbuild",
    "prepublishOnly": "pnpm run build",
    "prepack": "node ../../../scripts/sync-framework-package-metadata.mjs --package ."
  },
  "files": [
    "AGENTS.md",
    "docs",
    "dist",
    "src",
    "package-version.mjs",
    "package-version.d.mts",
    "README.md",
    "THIRD-PARTY-LICENSES.txt"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.vue"
  ],
  "main": "./dist/modules/com_levin_oak_base/index.mjs",
  "module": "./dist/modules/com_levin_oak_base/index.mjs",
  "types": "./dist/modules/com_levin_oak_base/index.d.ts",
  "exports": {
    "./ai-sdk-browser": {
      "types": "./dist/ai-sdk-browser.d.ts",
      "default": "./dist/ai-sdk-browser.mjs"
    },
    ".": {
      "development": "./src/modules/com_levin_oak_base/index.ts",
      "types": "./dist/modules/com_levin_oak_base/index.d.ts",
      "default": "./dist/modules/com_levin_oak_base/index.mjs"
    },
    "./modules/com_levin_oak_base": {
      "development": "./src/modules/com_levin_oak_base/index.ts",
      "types": "./dist/modules/com_levin_oak_base/index.d.ts",
      "default": "./dist/modules/com_levin_oak_base/index.mjs"
    },
    "./modules/com_levin_oak_base/*": {
      "development": "./src/modules/com_levin_oak_base/*.ts",
      "types": "./dist/modules/com_levin_oak_base/*.d.ts",
      "default": "./dist/modules/com_levin_oak_base/*.mjs"
    },
    "./modules/com_levin_oak_base/api/*": {
      "development": "./src/modules/com_levin_oak_base/api/*.ts",
      "types": "./dist/modules/com_levin_oak_base/api/*.d.ts",
      "default": "./dist/modules/com_levin_oak_base/api/*.mjs"
    },
    "./modules/com_levin_oak_base/api/index": {
      "development": "./src/modules/com_levin_oak_base/api/index.ts",
      "types": "./dist/modules/com_levin_oak_base/api/index.d.ts",
      "default": "./dist/modules/com_levin_oak_base/api/index.mjs"
    },
    "./modules/com_levin_oak_base/views/*.vue": {
      "development": "./src/modules/com_levin_oak_base/views/*.vue",
      "types": "./dist/modules/com_levin_oak_base/views/*.vue.d.ts",
      "default": "./dist/modules/com_levin_oak_base/views/*.vue"
    },
    "./modules/com_levin_oak_base/views/*": {
      "development": "./src/modules/com_levin_oak_base/views/*.ts",
      "types": "./dist/modules/com_levin_oak_base/views/*.d.ts",
      "default": "./dist/modules/com_levin_oak_base/views/*.mjs"
    },
    "./package-version": {
      "types": "./package-version.d.mts",
      "default": "./package-version.mjs"
    }
  },
  "peerDependencies": {
    "@levin/admin-framework": "6.0.17",
    "@vben-core/ui": "6.0.1",
    "@vben/common-ui": "6.0.3",
    "@vben/runtime": "6.0.3",
    "ant-design-vue": ">=4.0.0",
    "pinia": ">=3.0.0",
    "vue": ">=3.5.0",
    "vue-router": ">=4.0.0"
  },
  "devDependencies": {
    "@levin/admin-framework": "workspace:*",
    "@vben-core/ui": "workspace:*",
    "@vben/common-ui": "workspace:*",
    "@vben/runtime": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "ant-design-vue": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.85",
    "@levin/bpm-designer": "workspace:*",
    "@levin/bpm-runtime-ui": "workspace:*",
    "ai": "6.0.309",
    "docx-preview": "^0.4.0"
  }
}
