{
  "name": "@vben/layouts",
  "version": "5.6.108",
  "homepage": "https://github.com/vbenjs/vue-vben-admin",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbenjs/vue-vben-admin.git",
    "directory": "packages/effects/layouts"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node ../../../scripts/sync-framework-package-metadata.mjs --package . && pnpm unbuild",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../../scripts/sync-framework-package-metadata.mjs --package ."
  },
  "files": [
    "dist",
    "src",
    "package-version.mjs",
    "package-version.d.mts",
    "docs",
    "AGENTS.md",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./basic/header-extension-area": {
      "types": "./src/basic/header/header-extension-area.ts",
      "development": "./src/basic/header/header-extension-area.ts",
      "default": "./dist/basic/header/header-extension-area.mjs"
    },
    "./package-version": {
      "types": "./package-version.d.mts",
      "default": "./package-version.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./basic/header-extension-area": {
        "types": "./dist/basic/header/header-extension-area.d.ts",
        "default": "./dist/basic/header/header-extension-area.mjs"
      },
      "./package-version": {
        "types": "./package-version.d.mts",
        "default": "./package-version.mjs"
      }
    }
  },
  "dependencies": {
    "@vben-core/foundation": "workspace:*",
    "@vben-core/ui": "workspace:*",
    "@vben/runtime": "workspace:*",
    "@vueuse/core": "catalog:",
    "ant-design-vue": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  }
}
