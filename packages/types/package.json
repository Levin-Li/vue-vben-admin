{
  "name": "@vben/types",
  "version": "5.6.9",
  "homepage": "https://github.com/vbenjs/vue-vben-admin",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbenjs/vue-vben-admin.git",
    "directory": "packages/types"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs",
      "development": "./src/index.ts"
    },
    "./global": {
      "types": "./global.d.ts",
      "development": "./global.d.ts",
      "default": "./global.d.ts"
    },
    "./package-version": {
      "types": "./package-version.d.mts",
      "default": "./package-version.mjs"
    }
  },
  "dependencies": {
    "@vben-core/typings": "workspace:*",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "scripts": {
    "build": "node ../../scripts/sync-framework-package-metadata.mjs --package . && pnpm unbuild",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../scripts/sync-framework-package-metadata.mjs --package ."
  },
  "files": [
    "dist",
    "src",
    "global.d.ts",
    "package-version.mjs",
    "package-version.d.mts",
    "docs",
    "AGENTS.md",
    "README.md"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./global": {
        "types": "./global.d.ts"
      },
      "./package-version": {
        "types": "./package-version.d.mts",
        "default": "./package-version.mjs"
      }
    }
  }
}
