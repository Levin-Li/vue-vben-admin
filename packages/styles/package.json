{
  "name": "@vben/styles",
  "version": "5.6.9",
  "homepage": "https://github.com/vbenjs/vue-vben-admin",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbenjs/vue-vben-admin.git",
    "directory": "packages/styles"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs",
      "development": "./src/index.ts"
    },
    "./antd": {
      "default": "./dist/antd/index.css",
      "development": "./src/antd/index.css"
    },
    "./antdv-next": {
      "default": "./dist/antdv-next/index.css",
      "development": "./src/antdv-next/index.css"
    },
    "./ele": {
      "default": "./dist/ele/index.css",
      "development": "./src/ele/index.css"
    },
    "./naive": {
      "default": "./dist/naive/index.css",
      "development": "./src/naive/index.css"
    },
    "./global": {
      "default": "./dist/global/index.scss",
      "development": "./src/global/index.scss"
    },
    "./package-version": {
      "types": "./package-version.d.mts",
      "default": "./package-version.mjs"
    }
  },
  "dependencies": {
    "@vben-core/design": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/sync-framework-package-metadata.mjs --package . && pnpm unbuild && node scripts/copy-assets.mjs",
    "prepublishOnly": "npm run build",
    "prepack": "node ../../scripts/sync-framework-package-metadata.mjs --package ."
  },
  "files": [
    "dist",
    "src",
    "package-version.mjs",
    "package-version.d.mts",
    "docs",
    "AGENTS.md",
    "README.md"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./antd": {
        "default": "./dist/antd/index.css"
      },
      "./antdv-next": {
        "default": "./dist/antdv-next/index.css"
      },
      "./ele": {
        "default": "./dist/ele/index.css"
      },
      "./naive": {
        "default": "./dist/naive/index.css"
      },
      "./global": {
        "default": "./dist/global/index.scss"
      },
      "./package-version": {
        "types": "./package-version.d.mts",
        "default": "./package-version.mjs"
      }
    }
  }
}
